{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spatial Journalism Story",
  "description": "JSON schema for Spatial Journalism Engine story configuration",
  "type": "object",
  "required": ["project", "scenes"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string", "default": "1.0" },
        "languages": { 
          "type": "array", 
          "items": { "type": "string" },
          "default": ["en"]
        },
        "defaultLanguage": { "type": "string", "default": "en" },
        "modes": {
          "type": "array",
          "items": { "enum": ["ar", "3d", "guided", "exploration"] }
        },
        "assets": {
          "type": "object",
          "properties": {
            "basePath": { "type": "string", "default": "./assets/" },
            "environment": { "type": "string" },
            "preload": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "description": "Camera control configuration",
      "properties": {
        "moveSpeed": { "type": "number", "default": 0.005 },
        "rotateSpeed": { "type": "number", "default": 0.003 },
        "bounds": {
          "type": "object",
          "properties": {
            "minX": { "type": "number" },
            "maxX": { "type": "number" },
            "minY": { "type": "number" },
            "maxY": { "type": "number" },
            "minZ": { "type": "number" },
            "maxZ": { "type": "number" }
          }
        },
        "buffer": { "type": "number", "default": 0.5 },
        "recenterPosition": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "recenterRotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "rendering": {
      "type": "object",
      "description": "Global rendering settings for the Three.js renderer",
      "properties": {
        "toneMapping": {
          "type": "string",
          "enum": ["none", "linear", "reinhard", "cineon", "ACESFilmic"],
          "default": "ACESFilmic",
          "description": "Tone mapping algorithm"
        },
        "toneMappingExposure": {
          "type": "number",
          "default": 2,
          "description": "Tone mapping exposure level"
        },
        "fog": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["exponential", "linear"],
              "description": "Fog type"
            },
            "color": { "type": "string", "default": "0xcccccc" },
            "density": { "type": "number", "default": 0.15, "description": "Density for exponential fog" },
            "near": { "type": "number", "description": "Near distance for linear fog" },
            "far": { "type": "number", "description": "Far distance for linear fog" }
          }
        }
      }
    },
    "particles": {
      "type": "object",
      "description": "Particle effects configuration (dust, atmosphere, etc.)",
      "properties": {
        "count": { "type": "integer", "default": 2000, "description": "Number of particles" },
        "color": { "type": "string", "default": "0xcccccc", "description": "Particle color as hex string" },
        "size": { "type": "number", "default": 0.005, "description": "Particle point size" },
        "opacity": { "type": "number", "default": 0.3, "description": "Particle opacity (0-1)" },
        "blending": {
          "type": "string",
          "enum": ["additive", "normal", "subtractive", "multiply"],
          "default": "additive"
        },
        "area": {
          "type": "object",
          "description": "Spawn volume dimensions",
          "properties": {
            "width": { "type": "number", "default": 4 },
            "height": { "type": "number", "default": 1.5 },
            "depth": { "type": "number", "default": 4 },
            "offsetX": { "type": "number", "default": 0 },
            "offsetY": { "type": "number", "default": 0 },
            "offsetZ": { "type": "number", "default": 0 }
          }
        },
        "animation": {
          "type": "object",
          "description": "Particle movement animation",
          "properties": {
            "rotationSpeed": { "type": "number", "default": 0.0001, "description": "Y-axis rotation speed per frame" },
            "driftSpeed": { "type": "number", "default": 0.0005, "description": "Upward drift speed per frame" },
            "resetHeight": { "type": "number", "default": 3, "description": "Height at which particles reset" },
            "resetToHeight": { "type": "number", "default": 1, "description": "Height particles reset to" }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          },
          "audio": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "volume": { "type": "number", "default": 0.5 },
              "loop": { "type": "boolean", "default": false },
              "autoplay": { "type": "boolean", "default": true },
              "delay": { "type": "number", "default": 0 },
              "positional": { "type": "boolean", "default": false },
              "position": { "type": "array", "items": { "type": "number" } },
              "refDistance": { "type": "number", "default": 15 },
              "maxDistance": { "type": "number", "default": 50 },
              "waypoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "time": { "type": "number" },
                    "position": { "type": "array", "items": { "type": "number" } }
                  }
                }
              }
            }
          },
          "subtitles": {
            "type": "object",
            "description": "Subtitles per language",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["start", "end", "text"],
                "properties": {
                  "start": { "type": "number" },
                  "end": { "type": "number" },
                  "text": { "type": "string" }
                }
              }
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "model": { "type": "string" },
                "position": { "type": "array", "items": { "type": "number" } },
                "rotation": { "type": "array", "items": { "type": "number" } },
                "scale": { "type": "number" },
                "animation": { "type": "string" },
                "delay": { "type": "number", "default": 0 },
                "opacity": { "type": "number", "default": 0.7 },
                "fadeInDuration": { "type": "number", "default": 3000 },
                "fadeOutDuration": { "type": "number" },
                "fadeOutDelay": { "type": "number" }
              }
            }
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "model": { "type": "string" },
                "position": { "type": "array", "items": { "type": "number" } },
                "rotation": { "type": "array", "items": { "type": "number" } },
                "scale": { "type": "number" }
              }
            }
          },
          "videos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "url": { "type": "string" },
                "position": { "type": "array", "items": { "type": "number" } },
                "rotation": { "type": "array", "items": { "type": "number" } },
                "size": { "type": "array", "items": { "type": "number" } },
                "opacity": { "type": "number", "default": 0.9 },
                "loop": { "type": "boolean", "default": false },
                "muted": { "type": "boolean", "default": true },
                "triggerAt": { "type": "number" },
                "multiWall": { "type": "boolean", "default": false },
                "walls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "position": { "type": "array", "items": { "type": "number" } },
                      "rotation": { "type": "array", "items": { "type": "number" } }
                    }
                  }
                }
              }
            }
          },
          "lighting": {
            "type": "object",
            "properties": {
              "position": { "type": "array", "items": { "type": "number" } },
              "ambient": { "type": "number", "default": 1 },
              "directional": { "type": "number", "default": 1 },
              "hemisphere": { "type": "number", "default": 1 },
              "volumetric": { "type": "boolean", "default": true },
              "volumetricOffset": { "type": "number", "default": 13.5 },
              "effects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": { "enum": ["walkingTour", "flicker"] },
                    "triggerTime": { "type": "number" },
                    "waypoints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "time": { "type": "number" },
                          "position": { "type": "array", "items": { "type": "number" } }
                        }
                      }
                    },
                    "dimLights": {
                      "type": "object",
                      "properties": {
                        "ambient": { "type": "number" },
                        "directional": { "type": "number" },
                        "hemisphere": { "type": "number" }
                      }
                    },
                    "endLights": {
                      "type": "object",
                      "properties": {
                        "ambient": { "type": "number" },
                        "directional": { "type": "number" },
                        "hemisphere": { "type": "number" }
                      }
                    },
                    "patterns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "duration": { "type": "number" },
                          "intensity": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "nextScene": { "type": "string" },
          "activateInteractionOutlines": { 
            "type": "boolean",
            "description": "When true, enables glowing outline effect on interactable objects during this scene"
          }
        }
      }
    },
    "interactableObjects": {
      "type": "array",
      "description": "Interactive 3D objects the user can click/touch to inspect",
      "items": {
        "type": "object",
        "required": ["id", "model", "original"],
        "properties": {
          "id": { "type": "string", "description": "Unique identifier for this interactive object" },
          "name": {
            "type": "object",
            "description": "Localized display name",
            "additionalProperties": { "type": "string" }
          },
          "model": { "type": "string", "description": "Path to GLB/GLTF model file" },
          "original": {
            "type": "object",
            "description": "Default (resting) state transforms",
            "properties": {
              "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "scale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            }
          },
          "transformed": {
            "type": "object",
            "description": "Clicked/inspected state transforms",
            "properties": {
              "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "scale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            }
          },
          "hasInfoBox": { "type": "boolean", "default": false, "description": "Whether tapping shows an info card" },
          "infoBoxMessage": {
            "type": "object",
            "description": "Localized info box content",
            "additionalProperties": { "type": "string" }
          },
          "enableRotation": { "type": "boolean", "default": false, "description": "Whether the object rotates when clicked" }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "homeScreen": {
          "type": "object",
          "properties": {
            "backgroundImage": { "type": "string" },
            "backgroundImageDesktop": { "type": "string" },
            "title": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "additionalProperties": { "type": "string" } }
              ]
            },
            "subtitle": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "additionalProperties": { "type": "string" } }
              ]
            },
            "startButtonText": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "additionalProperties": { "type": "string" } }
              ]
            }
          }
        },
        "branding": {
          "type": "object",
          "properties": {
            "logo": { "type": "string" },
            "primaryColor": { "type": "string" },
            "font": { "type": "string" },
            "fontFiles": {
              "type": "object",
              "properties": {
                "woff2": { "type": "string" },
                "woff": { "type": "string" }
              }
            }
          }
        },
        "controls": {
          "type": "object",
          "properties": {
            "showRecenter": { "type": "boolean", "default": true },
            "showSkip": { "type": "boolean", "default": true },
            "showSettings": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "ending": {
      "type": "object",
      "properties": {
        "video": { "type": "string" },
        "text": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": { "type": "string" } }
          ]
        },
        "quotes": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          }
        },
        "buttons": {
          "type": "object",
          "properties": {
            "learnMore": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "additionalProperties": { "type": "string" } }
              ]
            },
            "returnHome": {
              "oneOf": [
                { "type": "string" },
                { "type": "object", "additionalProperties": { "type": "string" } }
              ]
            }
          }
        },
        "triggerMode": {
          "type": "string",
          "enum": ["audioEnd", "lastVideo", "characterFade"],
          "default": "audioEnd",
          "description": "What triggers the ending sequence: audio end (default), last video end, or character opacity fade-out"
        },
        "triggerCharacterId": {
          "type": "string",
          "description": "Character ID to monitor opacity for characterFade trigger"
        },
        "triggerSceneId": {
          "type": "string",
          "description": "Scene ID where the ending condition is checked"
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "additionalProperties": { "type": "string" } }
                ]
              },
              "name": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
