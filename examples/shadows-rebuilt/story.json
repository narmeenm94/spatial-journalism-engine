    {
      "id": "scene2",
      "name": { "en": "Oleh's Story", "fi": "Olehin tarina" },
      "audio": {
        "url": "audio/Scene_2.mp3",
        "volume": 0.5,
        "loop": false,
        "autoplay": true,
        "delay": 0
      },
      "subtitles": {
        "en": [
          {"start": 5, "end": 8, "text": "This is it. My love,"},
          {"start": 8, "end": 11, "text": "take care of the children."},
          {"start": 35, "end": 37, "text": "They fired at us. They shelled us,"},
          {"start": 37, "end": 40, "text": "and the village behind us"},
          {"start": 40, "end": 43, "text": "was shelled with 120mm mortars."},
          {"start": 45, "end": 49, "text": "I couldn't feel my legs. There was no pain."},
          {"start": 49, "end": 53, "text": "I saw my leg. My boot was torn apart."},
          {"start": 56, "end": 60, "text": "It happened 13 May 2024 at 12:20."},
          {"start": 60, "end": 64, "text": "I remember the exact time,"},
          {"start": 64, "end": 67, "text": "because I checked it after applying the tourniquet."},
          {"start": 67, "end": 70, "text": "I needed to know when to remove the tourniquet,"},
          {"start": 70, "end": 73, "text": "in order to not lose my leg."},
          {"start": 73, "end": 77, "text": "Our comrades-in-arms ran through the trenches to us from 700 metres away."},
          {"start": 77, "end": 82, "text": "Evacuation was difficult, because we were constantly under fire."},
          {"start": 84, "end": 87, "text": "The men dragged us through the forest to the edge of the village"},
          {"start": 87, "end": 89, "text": "trying to avoid the gunfire."},
          {"start": 89, "end": 95, "text": "There were some houses still standing,"},
          {"start": 95, "end": 98, "text": "and a vehicle was hidden there."},
          {"start": 98, "end": 100, "text": "They evacuated us from there."},
          {"start": 100, "end": 104, "text": "There was no other way."},
          {"start": 104, "end": 108, "text": "Our comrades dragged us for two kilometres."},
          {"start": 115, "end": 117, "text": "Where does it hurt?"},
          {"start": 117, "end": 119, "text": "My left leg."},
          {"start": 120, "end": 123, "text": "The left leg is slightly wounded."},
          {"start": 141, "end": 145, "text": "Oleh had lost a lot of blood."},
          {"start": 145, "end": 153, "text": "In the ambulance, they put him on a drip right away, in order to give him medication intravenously."},
          {"start": 153, "end": 157, "text": "Right away, they started him on painkillers,"},
          {"start": 157, "end": 161, "text": "hemostatic agents to stop the bleeding, and other medication required."},
          {"start": 167, "end": 169, "text": "Oleh had already received first aid."},
          {"start": 169, "end": 172, "text": "Here, the doctors stabilised him and examined him more."},
          {"start": 172, "end": 177, "text": "They removed the tourniquet, assessed the cause of the bleeding"},
          {"start": 177, "end": 179, "text": "and what exactly was happening."},
          {"start": 179, "end": 183, "text": "Here, Oleh had his first surgery."},
          {"start": 183, "end": 186, "text": "All his wounds were bandaged carefully,"},
          {"start": 186, "end": 189, "text": "and he was sent to the hospital,"},
          {"start": 189, "end": 193, "text": "as you do in cases like this."},
          {"start": 196, "end": 202, "text": "I remember lights flickering between light and dark like in the movies."},
          {"start": 202, "end": 206, "text": "I lost consciousness."},
          {"start": 206, "end": 210, "text": "After that, I don't remember anything but a girl named Olena."}
        ],
        "fi": [
          {"start": 5, "end": 7, "text": "Se oli siinä."},
          {"start": 7, "end": 11, "text": "Rakkaani, pidä huolta lapsista."},
          {"start": 35, "end": 40, "text": "Meitä ammuttiin, samoin kylää takanamme."},
          {"start": 40, "end": 43, "text": "120 millimetrin kranaatinheittimillä."},
          {"start": 45, "end": 49, "text": "En tuntenut jalkojani. Niissä ei ollut kipua."},
          {"start": 49, "end": 53, "text": "Näin jalkani ja että saapas oli revennyt."},
          {"start": 56, "end": 60, "text": "Se tapahtui 13.5.2024 klo 12.20."},
          {"start": 60, "end": 64, "text": "Muistan kellonajan tarkasti,"},
          {"start": 64, "end": 67, "text": "koska katsoin kelloa"},
          {"start": 67, "end": 73, "text": "kiristyssiteen pantuani."},
          {"start": 73, "end": 77, "text": "Minun piti tietää, milloin ottaa side pois, etten menettäisi jalkaani."},
          {"start": 77, "end": 82, "text": "Taistelutoverit juoksivat luoksemme juoksuhautoja pitkin 700 metrin päästä."},
          {"start": 84, "end": 87, "text": "Evakuointi oli vaikeaa, koska meitä tulitettiin koko ajan."},
          {"start": 87, "end": 89, "text": "Miehet raahasivat meidät metsän läpi kylän reunalle -"},
          {"start": 89, "end": 95, "text": "yrittäen väistellä tulitusta."},
          {"start": 95, "end": 98, "text": "Kylässä oli vielä joitakin taloja pystyssä -"},
          {"start": 98, "end": 100, "text": "ja sinne oli piilotettu ajoneuvo."},
          {"start": 100, "end": 104, "text": "Sieltä meidät evakuoitiin."},
          {"start": 104, "end": 108, "text": "Toverit raahasivat meitä kaksi kilometriä."},
          {"start": 115, "end": 117, "text": "Mihin sattuu?"},
          {"start": 117, "end": 119, "text": "Vasempaan jalkaan."},
          {"start": 120, "end": 123, "text": "Vasen jalka on vähän haavoittunut, joten..."},
          {"start": 141, "end": 145, "text": "Oleh oli menettänyt paljon verta -"},
          {"start": 145, "end": 153, "text": "ja hänet pantiin heti sairaankuljetusautossa tiputukseen, -"},
          {"start": 153, "end": 157, "text": "jotta hänelle saatiin annettua lääkettä suoraan suoneen."},
          {"start": 157, "end": 161, "text": "Hänelle annettiin heti kipulääkettä, -"},
          {"start": 161, "end": 167, "text": "verenvuotoa tyrehdyttävää lääkettä ja muita tarvittavia lääkkeitä."},
          {"start": 167, "end": 169, "text": "Oleh oli saanut jo ensihoitoa -"},
          {"start": 169, "end": 172, "text": "ja täällä lääkärit tutkivat häntä lisää."},
          {"start": 172, "end": 177, "text": "He irrottivat kiristyssiteen ja tutkivat,"},
          {"start": 177, "end": 179, "text": "mistä verenvuoto johtui."},
          {"start": 179, "end": 183, "text": "Täällä Oleh leikattiin ensimmäisen kerran."},
          {"start": 183, "end": 186, "text": "Kaikki hänen haavansa sidottiin huolellisesti -"},
          {"start": 186, "end": 189, "text": "ja hänet lähetettiin sairaalaan, -"},
          {"start": 189, "end": 193, "text": "kuten tällaisissa tapauksissa tehdään."},
          {"start": 196, "end": 202, "text": "Muistan, kuinka valot välähtelivät, oli vuorotellen pimeää ja valoisaa."},
          {"start": 202, "end": 206, "text": "Niin kuin elokuvissa."},
          {"start": 206, "end": 210, "text": "Sen jälkeen en muista muuta. Paitsi Olena-tytön."}
        ]
      },
