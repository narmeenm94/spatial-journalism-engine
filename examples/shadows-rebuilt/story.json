  "scenes": [
    {
      "id": "scene1",
      "name": { "en": "Introduction", "fi": "Johdanto" },
      "audio": {
        "url": "audio/Scene_1.mp3",
        "volume": 0.5,
        "loop": false,
        "autoplay": true,
        "delay": 1000
      },
      "subtitles": {
        "en": [
          {"start": 0, "end": 4, "text": "My name is Olena. I'm the senior nurse at the stabilisation point."},
          {"start": 5, "end": 8, "text": "This stabilisation point is the first place"},
          {"start": 8, "end": 12, "text": "where wounded soldiers are brought straight from the front"},
          {"start": 12, "end": 15, "text": "to receive medical aid."},
          {"start": 15, "end": 21, "text": "At first, they may have been treated by a combat medic or a paramedic during evacuation."},
          {"start": 21, "end": 23, "text": "But here, there are actual doctors present."},
          {"start": 23, "end": 26, "text": "Here, medical help is provided"},
          {"start": 26, "end": 29, "text": "to fully stabilise the patients as much as possible."}
        ],
        "fi": [
          {"start": 0, "end": 4, "text": "Nimeni on Olena. Olen sairaanhoitajana ensihoitoklinikalla."},
          {"start": 5, "end": 8, "text": "Tämä ensiapupiste on ensimmäinen paikka, -"},
          {"start": 8, "end": 12, "text": "johon apua tarvitsevat sotilaat tuodaan rintamalta."},
          {"start": 12, "end": 15, "text": "Täällä he saavat lääkärin apua."},
          {"start": 15, "end": 21, "text": "Alkuvaiheessa apua on voinut antaa sotilaslääkäri tai ensihoitaja."},
          {"start": 21, "end": 25, "text": "Täällä he saavat apua jo oikeilta lääkäreiltä -"},
          {"start": 25, "end": 29, "text": "ja potilaan tila pyritään vakauttamaan mahdollisimman hyvin."}
        ]
      },
      "characters": [
        {
          "id": "olena-scene1",
          "model": "models/Olena_animations.glb",
          "position": [-2, -25, -5],
          "scale": 10,
          "rotation": [0, 0.785, 0],
          "animation": "Talking_Olena",
          "opacity": 0.7
        }
      ],
      "videos": [
        {
          "id": "Olena-intro",
          "url": "video/Olena_name.mp4",
          "position": [-15.3, -7.0, 5.25],
          "rotation": [0, 1.5708, 0],
          "size": [64, 40],
          "opacity": 0.9,
          "loop": false,
          "muted": true,
          "triggerAt": 0.1
        },
        {
          "id": "StabilisationPointIntro",
