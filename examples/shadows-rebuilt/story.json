    {
      "id": "scene4",
      "name": { "en": "Reflection", "fi": "Heijastus" },
      "audio": {
        "url": "audio/Scene_4.mp3",
        "volume": 0.5,
        "loop": false,
        "autoplay": true,
        "delay": 0
      },
      "subtitles": {
        "en": [
          {"start": 1, "end": 3, "text": "One more question."},
          {"start": 3, "end": 10, "text": "Tomorrow, your brothers-in-arms will bring in the bodies of your fallen comrades."},
          {"start": 10, "end": 13, "text": "Could you let me know what time they will be arriving, approximately?"},
          {"start": 13, "end": 16, "text": "I need to register all the information"},
          {"start": 16, "end": 21, "text": "about the bodies, the injuries, and the preliminary diagnosis, as I'm sure you know."},
          {"start": 21, "end": 24, "text": "I kindly ask you to inform me"},
          {"start": 24, "end": 27, "text": "when they will approximately be at the stabilisation point."},
          {"start": 28, "end": 30, "text": "It's very difficult when"},
          {"start": 30, "end": 34, "text": "it's not possible to save someone who is wounded."},
          {"start": 34, "end": 37, "text": "It's really hard."},
          {"start": 38, "end": 40, "text": "There are cases like that."},
          {"start": 40, "end": 45, "text": "Unfortunately, there are injuries that end the patient's life."},
          {"start": 45, "end": 51, "text": "That is the worst part."},
          {"start": 51, "end": 55, "text": "It's also horrible when"},
          {"start": 55, "end": 61, "text": "there are people who go missing without a trace."},
          {"start": 61, "end": 63, "text": "for their families,"},
          {"start": 63, "end": 67, "text": "I can't even imagine how painful it must be,"},
          {"start": 67, "end": 69, "text": "because"},
          {"start": 69, "end": 74, "text": "they don't know whether the person is dead or in captivity."},
          {"start": 74, "end": 77, "text": "The relatives wait until the last moment."},
          {"start": 79, "end": 84, "text": "Hope dies last, as they say."},
          {"start": 84, "end": 92, "text": "But still, mothers, wives, sisters, or whoever they may be, hope that they will come back."},
          {"start": 92, "end": 95, "text": "But they won't come back."}
        ],
        "fi": [
          {"start": 1, "end": 3, "text": "Vielä yksi kysymys."},
          {"start": 3, "end": 10, "text": "Aseveljenne tuovat sinne huomenna kaatuneiden sotilaiden ruumiit."},
          {"start": 10, "end": 13, "text": "Voisitteko ilmoittaa, mihin aikaan he ovat tulossa?"},
          {"start": 13, "end": 16, "text": "Minun on kirjattava kaikki tiedot -"},
          {"start": 16, "end": 21, "text": "ruumiit, vammat ja alustavat diagnoosit, kuten varmaan tiedätte."},
          {"start": 21, "end": 24, "text": "Eli ilmoittaisitteko minulle, -"},
          {"start": 24, "end": 27, "text": "mihin aikaan he suurin piirtein ovat tulossa?"},
          {"start": 28, "end": 30, "text": "On kamalaa,"},
          {"start": 30, "end": 34, "text": "kun ei pysty pelastamaan haavoittunutta."},
          {"start": 34, "end": 37, "text": "Se on aivan kamalaa."},
          {"start": 38, "end": 40, "text": "On sellaisia tapauksia."},
          {"start": 40, "end": 45, "text": "Niin pahoja vammoja, että elämä päättyy niihin."},
          {"start": 45, "end": 51, "text": "Se on kaikkein pahinta."},
          {"start": 51, "end": 55, "text": "Ja todella hirveitä ovat myös tapaukset, -"},
          {"start": 55, "end": 61, "text": "joissa ihminen katoaa jälkiä jättämättä."},
          {"start": 61, "end": 63, "text": "En pysty edes kuvittelemaan, -"},
          {"start": 63, "end": 67, "text": "kuinka raskasta sellainen on perheelle."},
          {"start": 67, "end": 69, "text": "Sillä..."},
          {"start": 69, "end": 74, "text": "Ei tiedä, onko läheinen kuollut tai vangittu."},
          {"start": 74, "end": 77, "text": "Sukulaiset odottavat viimeiseen asti."},
          {"start": 79, "end": 84, "text": "Sitähän sanotaan, että toivo kuolee viimeisenä."},
          {"start": 84, "end": 92, "text": "Niinpä he toivovat. Äidit, vaimot ja sisaret, kuka nyt kyseessä onkaan, -"},
          {"start": 92, "end": 95, "text": "he toivovat, että heidän läheisensä palaavat."},
          {"start": 95, "end": 98, "text": "Mutta eivät he palaa."}
        ]
      },
