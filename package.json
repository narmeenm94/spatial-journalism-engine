{
  "name": "spatial-journalism-engine",
  "version": "1.0.0",
  "description": "JSON-driven spatial journalism platform for creating immersive WebAR experiences",
  "main": "engine/src/index.js",
  "scripts": {
    "build": "webpack --config engine/webpack.config.js",
    "build:prod": "webpack --config engine/webpack.config.js --mode production",
    "dev": "webpack serve --config engine/webpack.config.js",
    "generator": "npx serve generator -p 3001",
    "test": "jest",
    "lint": "eslint engine/src/**/*.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yle/spatial-journalism-engine.git"
  },
  "keywords": [
